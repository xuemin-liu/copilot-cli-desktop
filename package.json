{
  "name": "copilot-cli-desktop",
  "version": "0.1.14",
  "private": true,
  "author": "copilot-cli-desktop contributors",
  "description": "An unofficial Windows-first Electron desktop shell for the GitHub Copilot CLI",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "main": "dist/src/main/main.js",
  "bin": {
    "copilot-desktop": "dist/src/cli/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run icon && tsc -p tsconfig.build.json && node scripts/build-renderer.mjs && node scripts/copy-static.mjs",
    "icon": "node scripts/generate-icon.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "test": "npm run build && node --test \"dist/src/**/*.test.js\"",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "fork:smoke": "npm run build && node dist/scripts/fork-smoke.js",
    "clipboard:smoke": "npm run build && node scripts/electron-side-chat-check.mjs --clipboard-switch",
    "side-chat:preview": "npm run build && node scripts/side-chat-preview.mjs",
    "cli": "npm run build && node dist/src/cli/cli.js",
    "cli:smoke": "npm run build && node dist/scripts/cli-smoke.js",
    "pack:win": "npm run build && electron-builder --dir && node dist/scripts/audit-package.js && node dist/scripts/package-smoke.js",
    "dist:win": "npm run build && electron-builder --win --publish never && node dist/scripts/audit-package.js && node dist/scripts/package-smoke.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "26.4.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@xterm/xterm": "6.0.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "dev.copilot-cli-desktop.app",
    "productName": "Copilot CLI Desktop",
    "asar": true,
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xuemin-liu",
        "repo": "copilot-cli-desktop"
      }
    ],
    "files": [
      "dist/**/*",
      "!**/*.map",
      "!**/*.test.js",
      "!**/*.test.d.ts",
      "!**/test/**",
      "!**/tests/**",
      "!**/fixtures/**",
      "!dist/**/*.test.js",
      "!dist/**/*.test.js.map",
      "!dist/**/*.map",
      "!dist/**/fixtures/**",
      "!dist/scripts/**",
      "build/icon.png",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "asarUnpack": [
      "**/node-pty/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Copilot-CLI-Desktop-Setup-${version}.${ext}"
    }
  }
}
