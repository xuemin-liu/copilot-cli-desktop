{
  "name": "copilot-cli-desktop",
  "version": "0.1.61",
  "private": true,
  "author": "copilot-cli-desktop contributors",
  "description": "An unofficial Electron desktop shell for the GitHub Copilot CLI, for Windows, macOS and Linux",
  "homepage": "https://github.com/xuemin-liu/copilot-cli-desktop",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "main": "dist/src/main/main.js",
  "bin": {
    "copilot-desktop": "dist/src/cli/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run icon && tsc -p tsconfig.build.json && node scripts/build-renderer.mjs && node scripts/copy-static.mjs",
    "icon": "node scripts/generate-icon.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "test": "npm run build && node --test \"dist/src/**/*.test.js\"",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "fork:smoke": "npm run build && node dist/scripts/fork-smoke.js",
    "usage:check": "npm run build && node scripts/usage-electron-check.mjs",
    "paste:check": "npm run build && node --test scripts/check-helpers.test.mjs && node scripts/terminal-paste-check.mjs && node scripts/electron-side-chat-check.mjs --native-paste",
    "clipboard:smoke": "npm run build && node scripts/electron-side-chat-check.mjs --clipboard-switch",
    "links:check": "node scripts/terminal-links-check.mjs",
    "sidebar:check": "node scripts/sidebar-projects-check.mjs",
    "git:check": "node scripts/git-ipc-check.mjs",
    "git-panel:check": "node scripts/git-panel-check.mjs",
    "git-panel-app:check": "node scripts/git-panel-app-check.mjs",
    "session-switch:check": "node scripts/session-project-switch-check.mjs",
    "session-name:check": "node scripts/session-name-dialog-check.mjs",
    "meeting:check": "npm run build && node scripts/electron-side-chat-check.mjs --meeting",
    "side-chat:preview": "npm run build && node scripts/side-chat-preview.mjs",
    "cli": "npm run build && node dist/src/cli/cli.js",
    "cli:smoke": "npm run build && node dist/scripts/cli-smoke.js",
    "browser-discovery:check": "npm run build && node scripts/browser-discovery-check.mjs",
    "browser-unattended:check": "npm run build && node scripts/browser-unattended-check.mjs && node scripts/browser-unattended-check.mjs --force-device-scale-factor=1.25",
    "pack:win": "npm run build && electron-builder --dir && node dist/scripts/audit-package.js && node dist/scripts/package-smoke.js",
    "dist:win": "npm run build && electron-builder --win --publish never && node dist/scripts/audit-package.js && node dist/scripts/package-smoke.js",
    "dist:mac": "npm run build && electron-builder --mac --publish never && node dist/scripts/audit-package.js",
    "dist:linux": "npm run build && electron-builder --linux --publish never && node dist/scripts/audit-package.js",
    "migration:smoke": "npm run build && node dist/scripts/migration-smoke.js",
    "migration:check": "npm run build && node scripts/migration-electron-check.mjs",
    "activity:check": "npm run build && node scripts/electron-side-chat-check.mjs --activity",
    "popout:check": "npm run build && node scripts/electron-side-chat-check.mjs --popout",
    "browser:check": "npm run build && node scripts/browser-debug-check.mjs && node scripts/browser-persistence-check.mjs && node scripts/browser-devtools-share-check.mjs && node scripts/browser-overrides-status-check.mjs && node scripts/browser-popup-overrides-check.mjs && node scripts/browser-overrides-private-check.mjs && node scripts/browser-profile-share-check.mjs && node scripts/browser-reader-check.mjs && node scripts/browser-pick-check.mjs && node scripts/browser-basics-check.mjs && node scripts/browser-dialog-check.mjs && node scripts/browser-context-check.mjs && node scripts/browser-permissions-check.mjs && node scripts/browser-test-check.mjs && node scripts/browser-discovery-check.mjs && node scripts/browser-unattended-check.mjs && node scripts/browser-unattended-check.mjs --force-device-scale-factor=1.25"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "electron-updater": "6.8.11",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@xterm/xterm": "6.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "dev.copilot-cli-desktop.app",
    "productName": "Copilot CLI Desktop",
    "asar": true,
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xuemin-liu",
        "repo": "copilot-cli-desktop"
      }
    ],
    "files": [
      "dist/**/*",
      "!**/*.map",
      "!**/*.test.js",
      "!**/*.test.d.ts",
      "!**/test/**",
      "!**/tests/**",
      "!**/fixtures/**",
      "!dist/**/*.test.js",
      "!dist/**/*.test.js.map",
      "!dist/**/*.map",
      "!dist/**/fixtures/**",
      "!dist/scripts/**",
      "build/icon.png",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "asarUnpack": [
      "**/node-pty/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Copilot-CLI-Desktop-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon-1024.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Copilot-CLI-Desktop-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon-1024.png",
      "category": "Development",
      "maintainer": "copilot-cli-desktop contributors",
      "synopsis": "Desktop shell for the GitHub Copilot CLI",
      "artifactName": "Copilot-CLI-Desktop-${version}-${arch}.${ext}",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
